# =========================================================
# Telegram — placeholders; nunca coloque valores reais neste arquivo.
# =========================================================
TELEGRAM_BOT_TOKEN=REPLACE_ME_TELEGRAM_BOT_TOKEN
TELEGRAM_ALLOWED_USER_ID=123456789

# =========================================================
# Hugging Face — necessário para pyannote/diarização.
# =========================================================
HF_TOKEN=hf_REPLACE_ME

# =========================================================
# YouTube cookies — prefira caminho absoluto para o arquivo local.
# O arquivo real de cookies não deve ser versionado.
# =========================================================
YOUTUBE_COOKIES_FILE=/caminho/absoluto/para/cookies.txt
# YOUTUBE_COOKIES_BROWSER=firefox

# =========================================================
# ASR / Whisper
# =========================================================
WHISPER_MODEL=auto
WHISPER_MODEL_PT=inesc-id/WhisperLv3-X-PT-All
WHISPER_MODEL_EN=medium
WHISPER_MODEL_DEFAULT=medium

DEVICE=auto
COMPUTE_TYPE=auto
PREFER_YOUTUBE_SUBTITLES=true

# =========================================================
# Limites e retenção
# =========================================================
MAX_VIDEO_DURATION_MIN=180
RETENTION_COUNT=5

# =========================================================
# Diretórios locais
# =========================================================
BASE_DIR=data
DOWNLOADS_DIR_NAME=downloads
PROCESSED_DIR_NAME=processed
TRANSCRIPTS_DIR_NAME=transcripts
LOGS_DIR_NAME=logs
MODELS_DIR=models
DB_PATH=data/jobs.db

# =========================================================
# UX Telegram
# =========================================================
TELEGRAM_MESSAGE_EDIT_MIN_INTERVAL_S=2.0
TELEGRAM_MAX_QUEUE_SIZE=5

# =========================================================
# Vídeo com legenda selecionável
# =========================================================
MAX_VIDEO_SUBTITLES_DURATION_MIN=30
MAX_VIDEO_SUBTITLES_SIZE_MB=200
VIDEO_EXPORTS_DIR_NAME=video_exports

# =========================================================
# Sumarização via LM Studio / API OpenAI-compatible
# LM Studio padrão: habilite o servidor local. Em WSL2 + LM Studio no Windows, habilite networkingMode=mirrored e use 127.0.0.1.
# =========================================================
SUMMARY_BACKEND=openai_compatible
SUMMARY_BASE_URL=http://127.0.0.1:1234/v1
SUMMARY_MODEL=qwen3.5-9b
SUMMARY_API_KEY=
SUMMARY_TEMPERATURE=0.2
SUMMARY_MAX_TOKENS=1024
SUMMARY_PARTIAL_MAX_TOKENS=512
SUMMARY_FINAL_MAX_TOKENS=1024
SUMMARY_MAX_CHARS_PER_CHUNK=18000
SUMMARY_MAX_INPUT_TOKENS=6000
SUMMARY_CHARS_PER_TOKEN=2.5
SUMMARY_TOKENIZER_BACKEND=auto
SUMMARY_TOKENIZER_MODEL=
SUMMARY_DEDUPLICATE_TRANSCRIPT=true
SUMMARY_MERGE_SAME_SPEAKER_GAP_S=2.0
SUMMARY_MIN_OVERLAP_WORDS=6
SUMMARY_TIMEOUT_S=600
SUMMARY_TIMEOUT_SPLIT_RETRIES=2
SUMMARY_OUTPUT_LANGUAGE=auto
SUMMARY_DISABLE_THINKING=true
SUMMARY_VALIDATE_MODEL=true
SUMMARY_STRICT_MODEL_MATCH=true
SUMMARIES_DIR_NAME=summaries
