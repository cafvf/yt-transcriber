# =========================================================
# Telegram — placeholders; nunca coloque valores reais neste arquivo.
# =========================================================
TELEGRAM_BOT_TOKEN=REPLACE_ME_TELEGRAM_BOT_TOKEN
TELEGRAM_ALLOWED_USER_ID=123456789

# =========================================================
# Hugging Face — necessário para pyannote/diarização.
# =========================================================
HF_TOKEN=hf_REPLACE_ME

# =========================================================
# YouTube cookies — prefira caminho absoluto para o arquivo local.
# O arquivo real de cookies não deve ser versionado.
# =========================================================
YOUTUBE_COOKIES_FILE=/caminho/absoluto/para/cookies.txt
# YOUTUBE_COOKIES_BROWSER=firefox

# =========================================================
# ASR / Whisper
# =========================================================
WHISPER_MODEL=auto
WHISPER_MODEL_PT=inesc-id/WhisperLv3-X-PT-All
WHISPER_MODEL_EN=medium
WHISPER_MODEL_DEFAULT=medium

DEVICE=auto
COMPUTE_TYPE=auto
PREFER_YOUTUBE_SUBTITLES=true

# =========================================================
# Limites e retenção
# =========================================================
MAX_VIDEO_DURATION_MIN=180
RETENTION_COUNT=5

# =========================================================
# Diretórios locais
# =========================================================
BASE_DIR=data
DOWNLOADS_DIR_NAME=downloads
PROCESSED_DIR_NAME=processed
TRANSCRIPTS_DIR_NAME=transcripts
LOGS_DIR_NAME=logs
MODELS_DIR=models
DB_PATH=data/jobs.db

# =========================================================
# UX Telegram
# =========================================================
TELEGRAM_MESSAGE_EDIT_MIN_INTERVAL_S=2.0
TELEGRAM_MAX_QUEUE_SIZE=5
